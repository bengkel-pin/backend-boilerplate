          "name": "Get All Karyawan",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/karyawan?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["karyawan"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "search", "value": "", "disabled": true },
                { "key": "status", "value": "AKTIF", "disabled": true },
                { "key": "departemen", "value": "TOKO", "disabled": true },
                { "key": "sistemUpah", "value": "HARIAN", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Karyawan by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/karyawan/{{karyawanId}}", "host": ["{{baseUrl}}"], "path": ["karyawan", "{{karyawanId}}"] }
          }
        },
        {
          "name": "Create Karyawan",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
