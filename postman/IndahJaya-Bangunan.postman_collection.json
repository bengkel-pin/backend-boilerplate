                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Budi Santoso\",\n  \"jenisKelamin\": \"LAKI_LAKI\",\n  \"jabatan\": \"Kasir\",\n  \"nomorHp\": \"081234567890\",\n  \"noRekening\": \"1234567890\",\n  \"alamat\": \"Jl. Merdeka No. 1, Jakarta\",\n  \"sistemUpah\": \"HARIAN\",\n  \"gajiPokok\": 150000\n}"
            },
            "url": { "raw": "{{baseUrl}}/karyawan", "host": ["{{baseUrl}}"], "path": ["karyawan"] }
          }
        },
        {
          "name": "Update Karyawan",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Budi Santoso\",\n  \"jenisKelamin\": \"LAKI_LAKI\",\n  \"jabatan\": \"Supervisor\",\n  \"nomorHp\": \"081234567890\",\n  \"noRekening\": \"1234567890\",\n  \"alamat\": \"Jl. Merdeka No. 1, Jakarta\",\n  \"sistemUpah\": \"BULANAN\",\n  \"gajiPokok\": 3000000\n}"
            },
            "url": { "raw": "{{baseUrl}}/karyawan/{{karyawanId}}", "host": ["{{baseUrl}}"], "path": ["karyawan", "{{karyawanId}}"] }
          }
        },
        {
          "name": "Delete Karyawan",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/karyawan/{{karyawanId}}", "host": ["{{baseUrl}}"], "path": ["karyawan", "{{karyawanId}}"] }
          }
        }
      ]
    },
    {
      "name": "Riwayat Kerja",
